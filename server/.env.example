# PostgreSQL (use a URL completa, como a fornecida por Neon, Supabase ou Render).
# Em desenvolvimento local, um exemplo comum é:
# DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/lixeira_tech
# A URL abaixo funciona com o docker-compose.yml fornecido para desenvolvimento local.
DATABASE_URL=postgresql://lixeira_tech:lixeira_tech_dev@localhost:5432/lixeira_tech

# Defina como "require" quando o seu provedor exigir SSL.
PGSSLMODE=

# Assistente Inteligente: chave opcional da OpenRouter.
# Sem esta chave, o assistente usa respostas locais e o site continua funcionando.
OPENROUTER_API_KEY=
